# ─────────────────────────────────────────────────────────────
# Supabase — 대시보드 > Project Settings 에서 복사
# ─────────────────────────────────────────────────────────────

# API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# API > Project API keys > anon / public  (브라우저 노출 O, RLS 로 보호됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Database > Connection string > Transaction pooler  (포트 6543 — 서버리스 필수)
# ⚠️ 5432(직접 연결) 아님. 반드시 6543.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────────────────────
# 앱
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
