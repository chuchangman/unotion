# ─────────────────────────────────────────────────────────────
# Supabase — 대시보드 > Project Settings 에서 복사
# ─────────────────────────────────────────────────────────────

# API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# API > Project API keys > anon / public  (브라우저 노출 O, RLS 로 보호됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Database > Connection string > Transaction pooler  (포트 6543 — 서버리스 필수)
# ⚠️ 5432(직접 연결) 아님. 반드시 6543.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────────────────────
# 앱
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# 회의 받아쓰기 (Whisper)
#
# 아무것도 안 넣어도 앱은 정상이다. 녹음을 눌러도 오디오는 브라우저에
# 보관되므로, 나중에 설정하고 "이어서 받아쓰기" 를 누르면 그대로 받아쓴다.
#
# ★ Whisper 는 오픈소스(MIT)다. 다만 "오픈소스" 는 **내 컴퓨터에서 공짜로
#   돌릴 수 있다**는 뜻이지 어딘가에 서버가 이미 떠 있다는 뜻이 아니다.
#   뭔가는 그 모델을 실행해야 한다. 아래 ①이 그 방법이다.
#
# 셋 중 하나를 고른다. 전부 OpenAI 호환 규격이라 앱 코드는 같다.
# ─────────────────────────────────────────────────────────────

# ① 공짜 + 회의 내용이 이 PC 밖으로 안 나감  ← 가입도 키도 필요 없음 (권장)
#
#      uv run scripts/whisper-server.py
#
#    그 창을 켜 둔 채 아래 두 줄만 넣으면 끝이다.
#    첫 실행은 모델을 내려받는다 (약 1.6GB, 한 번만).
#    빨리 확인만 하려면 --model small 을 붙인다.
#    사설/로컬 주소는 TRANSCRIBE_ALLOW_EXTERNAL 없이 통과하고 하루 상한도 안 센다.
# TRANSCRIBE_BASE_URL=http://127.0.0.1:8000/v1
# TRANSCRIBE_MODEL=large-v3-turbo

# ② 공짜지만 회의 내용이 밖으로 나감 — Groq 무료 티어
#    내 PC 가 느리거나 배터리를 아끼고 싶을 때. 가입 + 키 발급이 필요하다.
#    하루 오디오 28,800초(≈8시간), 분당 20회. 한도는 console.groq.com 에서 확인.
# OPENAI_API_KEY=gsk_...
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3
# TRANSCRIBE_ALLOW_EXTERNAL=true

# ③ 돈 내고 쓰기 — OpenAI. $0.006/분 (1시간 회의 ≈ $0.36)
# OPENAI_API_KEY=sk-...
# TRANSCRIBE_ALLOW_EXTERNAL=true

# ─────────────────────────────────────────────────────────────
# ★ 회의 오디오를 외부로 보내는 건 기본이 "차단" 이다.
#   사내/로컬 주소가 아닌 곳으로 보내려면 이 값을 명시적으로 켜야 한다.
#   키만 넣었다고 전 직원의 회의가 제3자 서버로 흘러가면 안 되기 때문이다.
#   ①을 쓰면 애초에 나가지 않으므로 켤 일이 없다.
# TRANSCRIBE_ALLOW_EXTERNAL=true

# 워크스페이스 하루 호출 상한 (외부 전송일 때만 적용). 기본 2000.
#   20초 구간 기준 2000회 ≈ 하루 11시간 분량. 0 이하면 상한 없음.
#   넘으면 전사만 멈추고 녹음은 계속 보관된다.
# TRANSCRIBE_DAILY_CALL_LIMIT=2000
